# Variables du chargement de la démo en ligne. Copier ce fichier en demo/.env.demo
# puis lancer depuis la racine du dépôt :
#   node --env-file=demo/.env.demo demo/seed.mjs

# Racine de l'API de l'instance visée. La version (/v1) est ajoutée par le script.
DEMO_API_URL=https://demo.butterfly.cheridanh.fr/api

# Compte propriétaire de la démo, saisi à la création des secrets (seal-secrets.sh demo).
# Guillemets conseillés autour du mot de passe. Éviter le caractère # : node --env-file le
# prend pour le début d'un commentaire.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD="change-me"

# Contenus seuls, sans comptes ni assignations : en ligne, l'administrateur crée lui-même
# les comptes des personnes invitées, qui reçoivent un vrai e-mail d'invitation.
DEMO_SKIP_ACCOUNTS=true
