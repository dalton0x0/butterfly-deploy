# Valeurs propres à la démonstration fusionnées avec ../base/backend.env.

CORS_ALLOWED_ORIGINS=https://demo.butterfly.cheridanh.fr
MAIL_FRONT_BASE_URL=https://demo.butterfly.cheridanh.fr

# Relais SMTP Brevo comme en production : les invitations doivent arriver chez les
# personnes à qui l'on montre la démo. Identifiants dans backend-secrets.
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=no-reply@cheridanh.fr

SPRINGDOC_SWAGGERUI_ENABLED=false
SPRINGDOC_APIDOCS_ENABLED=false
