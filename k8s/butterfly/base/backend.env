# Configuration non sensible du backend, commune à tous les environnements.
#
# Ce fichier est le catalogue complet des réglages du backend. Il se lit ainsi :
#
#   NOM=valeur     réglage appliqué à tous les environnements ;
#   #NOM=valeur    réglage laissé à sa valeur par défaut, celle du code (application.yaml
#                  et profil docker). La ligne la montre sans rien imposer : le code reste
#                  la seule source des défauts ;
#   # secret NOM   valeur sensible, fournie par un SealedSecret et jamais écrite ici.
#
# Pour changer un réglage partout, décommentez sa ligne ici. Pour un seul environnement,
# copiez la ligne sans le # dans son backend.env (staging/, demo/, prod/) : sa valeur
# remplace celle de ce fichier. Un changement redémarre le backend de lui-même (voir
# kustomization.yaml).
#
# scripts/check-backend-env.sh vérifie que ce catalogue reprend toutes les variables lues
# par le backend, et qu'aucun backend.env ne contient de nom inconnu.
#
# Format : une variable par ligne, sans guillemets. Tout ce qui suit le signe = fait
# partie de la valeur, espaces compris.

# --- Application ---------------------------------------------------------------------

# Profil docker et non prod : voir le README de ce dossier.
SPRING_PROFILES_ACTIVE=docker
#APP_NAME=butterfly

# Les dates sont des LocalDateTime, sans fuseau : le conteneur doit tourner dans celui
# des utilisateurs (voir docker-compose.yml).
TZ=Europe/Paris

# Port d'écoute. À changer avec containerPort et les sondes de backend.yaml.
#SERVER_PORT=8080

# Origines autorisées par CORS, séparées par des virgules. Propre à chaque environnement.
#CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Base de données -----------------------------------------------------------------

# Nom court du Service : la JVM le complète avec le namespace du pod.
DB_HOST=mysql
DB_PORT=3306
DB_NAME=butterfly
# secret DB_USERNAME (mysql-credentials)
# secret DB_PASSWORD (mysql-credentials)

# Pool de connexions.
#HIKARI_MAX_POOL_SIZE=10
#HIKARI_MIN_IDLE=2

# --- Authentification ----------------------------------------------------------------

# secret JWT_SECRET (backend-secrets)
# Durée de vie du jeton d'accès et du jeton de renouvellement, en millisecondes
# (15 minutes et 7 jours).
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Compte propriétaire, créé au premier démarrage.
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=Butterfly
# secret ADMIN_EMAIL (backend-secrets)
# secret ADMIN_PASSWORD (backend-secrets)

# Validité des liens envoyés par e-mail.
#TOKEN_EMAIL_VERIFICATION_TTL=24h
#TOKEN_PASSWORD_RESET_TTL=30m
TOKEN_ACCOUNT_ACTIVATION_TTL=72h
# Délai laissé pour vérifier son adresse avant blocage de la connexion.
#TOKEN_EMAIL_VERIFICATION_GRACE=7d
# Nettoyage nocturne des jetons expirés.
#TOKEN_CLEANUP_CRON=0 0 3 * * *

# Purge des comptes jamais vérifiés et sans aucune donnée. Suppression définitive.
#ACCOUNT_CLEANUP_ENABLED=false
#ACCOUNT_CLEANUP_RETENTION=30d
#ACCOUNT_CLEANUP_BATCH_SIZE=200

# Limitation de débit des routes d'authentification : rafale par adresse IP, puis par
# adresse e-mail, et durée de régénération.
#RATE_LIMIT_ENABLED=true
RATE_LIMIT_IP_CAPACITY=20
#RATE_LIMIT_IP_REFILL=5m
#RATE_LIMIT_EMAIL_CAPACITY=3
#RATE_LIMIT_EMAIL_REFILL=15m
#RATE_LIMIT_RETENTION=1h
#RATE_LIMIT_CLEANUP_INTERVAL=PT10M

# --- Apprentissage -------------------------------------------------------------------

# Seuil de réussite d'un quiz, entre 0 et 1.
#LEARNING_QUIZ_PASS_THRESHOLD=0.7
# Note maximale d'un exercice.
#LEARNING_MAX_GRADE=20
# Pourcentage à partir duquel un cours est terminé.
#LEARNING_COURSE_COMPLETED_PERCENT=100
# Durée d'une question de quiz qui n'en définit pas, en secondes.
#LEARNING_DEFAULT_QUESTION_TIME_SECONDS=30
# Marge accordée à chaque réponse au delà de cette durée, latence réseau comprise.
#LEARNING_QUIZ_ANSWER_TOLERANCE_SECONDS=5
# Taille des listes « récents » de l'aperçu et du tableau de bord.
#LEARNING_OVERVIEW_RECENT_LIMIT=5
#DASHBOARD_RECENT_BADGES_LIMIT=5

# Plafond de la taille de page acceptée. Au delà, Spring rabaisse la valeur en silence.
PAGE_MAX_SIZE=100

# --- Messagerie ----------------------------------------------------------------------

# false : les e-mails sont journalisés sans être envoyés.
MAIL_ENABLED=true
# Relais SMTP. Propre à chaque environnement.
#MAIL_HOST=localhost
#MAIL_PORT=1025
#MAIL_SMTP_AUTH=false
#MAIL_SMTP_STARTTLS=false
# secret MAIL_USERNAME (backend-secrets)
# secret MAIL_PASSWORD (backend-secrets)
# Délais du relais, en millisecondes.
#MAIL_CONNECTION_TIMEOUT=5000
#MAIL_TIMEOUT=5000
#MAIL_WRITE_TIMEOUT=5000

#MAIL_FROM=no-reply@butterfly.local
MAIL_FROM_NAME=Butterfly
# Slogan sous le nom en tête des e-mails, lignes séparées par |. Vide : slogan par défaut.
#MAIL_TAGLINE=
# Adresse de l'interface vue par le navigateur : les liens des e-mails y mènent.
#MAIL_FRONT_BASE_URL=http://localhost:5173
# Routes du front qui reçoivent les jetons.
#MAIL_VERIFICATION_PATH=/verification-email?token=
#MAIL_PASSWORD_RESET_PATH=/nouveau-mot-de-passe?token=
#MAIL_ACCOUNT_ACTIVATION_PATH=/activation-compte?token=
# Cache des gabarits d'e-mails.
#THYMELEAF_CACHE=true

# Notifications pédagogiques, envoyées par lots depuis une file en base. false : rien
# n'est mis en file (les e-mails de sécurité partent toujours).
NOTIFICATIONS_ENABLED=true
#NOTIFICATIONS_DISPATCH_INTERVAL=PT30S
NOTIFICATIONS_BATCH_SIZE=20
#NOTIFICATIONS_MAX_ATTEMPTS=5
# Récapitulatif quotidien des nouveautés.
NOTIFICATIONS_DIGEST_CRON=0 0 18 * * *
# Conservation des messages envoyés dans la file.
#NOTIFICATIONS_SENT_RETENTION=30d

# --- Cache ---------------------------------------------------------------------------

# redis ou simple (en mémoire du backend, sans Redis).
CACHE_TYPE=redis
REDIS_HOST=redis
REDIS_PORT=6379
# secret REDIS_PASSWORD (aucun : Redis n'est joignable que depuis le namespace)
#REDIS_TIMEOUT=500ms
#REDIS_CONNECT_TIMEOUT=500ms
# Durée de vie des entrées, filet de sécurité : elles sont invalidées à chaque changement.
#CACHE_PRINCIPAL_TTL=5m
#CACHE_SESSION_STATUS_TTL=5m

# --- Fichiers ------------------------------------------------------------------------

# Tous les fichiers sous /app/uploads, monté sur un volume persistant.
STORAGE_LOCATION=/app/uploads/exercise-submissions
EXERCISE_ATTACHMENT_LOCATION=/app/uploads/exercise-attachments
MEDIA_IMAGE_LOCATION=/app/uploads/media/images
MEDIA_VIDEO_LOCATION=/app/uploads/media/videos

# Tailles maximales, en octets sauf les deux limites globales de l'envoi multipart.
#STORAGE_MAX_FILE_SIZE_BYTES=20971520
EXERCISE_ATTACHMENT_MAX_FILE_SIZE_BYTES=10485760
EXERCISE_ATTACHMENT_MAX_FILES=10
#MEDIA_MAX_IMAGE_SIZE_BYTES=5242880
#MEDIA_MAX_VIDEO_SIZE_BYTES=209715200
#UPLOAD_MAX_FILE_SIZE=200MB
#UPLOAD_MAX_REQUEST_SIZE=210MB

# Un média envoyé puis jamais utilisé est supprimé après ce délai.
#MEDIA_PENDING_UPLOAD_RETENTION=24h
#MEDIA_CLEANUP_CRON=0 30 * * * *

# --- Journaux ------------------------------------------------------------------------

# Rotation du fichier de journal. Sans effet avec le profil docker, qui écrit seulement
# sur la sortie standard.
#LOG_MAX_FILE_SIZE=10MB
#LOG_MAX_HISTORY=14
#LOG_TOTAL_SIZE_CAP=500MB

# --- Documentation de l'API ----------------------------------------------------------

# Swagger, ouvert par le profil docker. Fermé en démo et en production.
#SPRINGDOC_SWAGGERUI_ENABLED=true
#SPRINGDOC_APIDOCS_ENABLED=true

# En-tête de la documentation Swagger. Pas de guillemets : Kustomize les garderait dans
# la valeur. La version suit celle du pom.xml tant que OPEN_API_VERSION reste
# commentée : une valeur vide l'effacerait.
OPEN_API_TITLE=Butterfly API
OPEN_API_DESCRIPTION=Plateforme d'apprentissage : apprendre, évoluer, se transformer
#OPEN_API_VERSION=3.7.0
OPEN_API_CONTACT_NAME=Chéridanh TSIELA
OPEN_API_CONTACT_EMAIL=contact@cheridanh.fr
OPEN_API_CONTACT_URL=https://cheridanh.fr
OPEN_API_LICENSE_NAME=Tous droits réservés
OPEN_API_LICENSE_URL=https://cheridanh.fr
