# Configuration non sensible du backend, commune à tous les environnements.
#
# Mêmes variables que dans docker-compose.yml. Chaque environnement complète ou remplace
# ces valeurs dans son propre backend.env. Les secrets (mots de passe, clé JWT) n'ont
# rien à faire ici : ils sont dans des SealedSecrets.
#
# Format : une variable par ligne, sans guillemets. Tout ce qui suit le signe = fait
# partie de la valeur, espaces compris.

# Profil docker et non prod : voir le README de ce dossier.
SPRING_PROFILES_ACTIVE=docker

# Les dates sont des LocalDateTime, sans fuseau : le conteneur doit tourner dans celui
# des utilisateurs (voir docker-compose.yml).
TZ=Europe/Paris

# Nom court du Service : la JVM le complète avec le namespace du pod.
DB_HOST=mysql
DB_PORT=3306
DB_NAME=butterfly

JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=Butterfly

MAIL_ENABLED=true
MAIL_FROM_NAME=Butterfly

NOTIFICATIONS_ENABLED=true
NOTIFICATIONS_BATCH_SIZE=20
NOTIFICATIONS_DIGEST_CRON=0 0 18 * * *

CACHE_TYPE=redis
REDIS_HOST=redis
REDIS_PORT=6379

# Tous les fichiers sous /app/uploads, monté sur un volume persistant.
STORAGE_LOCATION=/app/uploads/exercise-submissions
EXERCISE_ATTACHMENT_LOCATION=/app/uploads/exercise-attachments
MEDIA_IMAGE_LOCATION=/app/uploads/media/images
MEDIA_VIDEO_LOCATION=/app/uploads/media/videos

EXERCISE_ATTACHMENT_MAX_FILE_SIZE_BYTES=10485760
EXERCISE_ATTACHMENT_MAX_FILES=10
PAGE_MAX_SIZE=100
TOKEN_ACCOUNT_ACTIVATION_TTL=72h
RATE_LIMIT_IP_CAPACITY=20

# En-tête de la documentation Swagger. Pas de guillemets : Kustomize les garderait dans
# la valeur. La version n'est pas fixée : elle suit celle du pom.xml.
OPEN_API_TITLE=Butterfly API
OPEN_API_DESCRIPTION=Plateforme d'apprentissage : apprendre, évoluer, se transformer
OPEN_API_CONTACT_NAME=Chéridanh TSIELA
OPEN_API_CONTACT_EMAIL=contact@cheridanh.fr
OPEN_API_CONTACT_URL=https://cheridanh.fr
OPEN_API_LICENSE_NAME=Tous droits réservés
OPEN_API_LICENSE_URL=https://cheridanh.fr
