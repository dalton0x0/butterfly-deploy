# Configuration du backend propre à la production. Complète ../base/backend.env.

# Adresse publique de l'environnement, telle que l'ouvre le navigateur.
CORS_ALLOWED_ORIGINS=https://butterfly.cheridanh.fr
MAIL_FRONT_BASE_URL=https://butterfly.cheridanh.fr

# Relais SMTP Brevo. Identifiant et clé SMTP : secret backend-secrets.
# L'adresse d'expédition doit appartenir à un domaine authentifié chez Brevo.
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=no-reply@cheridanh.fr

# Swagger désactivé : la documentation de l'API n'a pas à être publique en production.
# Ces variables remplacent les valeurs du profil docker. Leur nom suit la règle de Spring
# pour les variables d'environnement : points remplacés par _, tirets supprimés
# (springdoc.swagger-ui.enabled devient SPRINGDOC_SWAGGERUI_ENABLED).
SPRINGDOC_SWAGGERUI_ENABLED=false
SPRINGDOC_APIDOCS_ENABLED=false
