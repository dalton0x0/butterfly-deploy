# Configuration du backend propre au staging. Complète ../base/backend.env.

# Adresse publique de l'environnement, telle que l'ouvre le navigateur.
CORS_ALLOWED_ORIGINS=https://staging.butterfly.cheridanh.fr
MAIL_FRONT_BASE_URL=https://staging.butterfly.cheridanh.fr

# Mailpit capture tous les messages : aucun e-mail ne sort du cluster. Les comptes de
# test peuvent ainsi utiliser n'importe quelle adresse sans risque.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@butterfly.local
