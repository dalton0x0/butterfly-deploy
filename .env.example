# Variables d'environnement du déploiement conteneurisé.
#
# Copiez ce fichier en .env à côté de docker-compose.yml
# puis renseignez les valeurs marquées comme obligatoires.
# Ce .env ne doit jamais être versionné.

# ---------------------------------------------------------------------------
# Emplacement des dépôts (obligatoire si vos clones portent d'autres noms)
# ---------------------------------------------------------------------------
# Chemins relatifs à ce fichier, vers les deux dépôts contenant chacun son Dockerfile.
BACKEND_PATH=../butterfly
FRONTEND_PATH=../butterfly-front

# ---------------------------------------------------------------------------
# Base de données (obligatoire)
# ---------------------------------------------------------------------------
DB_ROOT_PASSWORD=changez-ce-mot-de-passe-root
DB_NAME=butterfly
DB_USERNAME=butterfly
DB_PASSWORD=changez-ce-mot-de-passe

# Port exposé sur la machine hôte, pour inspection depuis un client SQL.
# Modifiez-le si une instance MySQL occupe déjà le port 3306.
DB_EXPOSED_PORT=3306

# ---------------------------------------------------------------------------
# Sécurité (obligatoire)
# ---------------------------------------------------------------------------
# Clé de signature des jetons, 32 caractères minimum.
# Générez-la plutôt que de l'inventer :
#   openssl rand -base64 48 ou sur https://jwtsecretkeygenerator.com/fr/
JWT_SECRET=

JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# ---------------------------------------------------------------------------
# Compte administrateur créé au premier démarrage (obligatoire)
# ---------------------------------------------------------------------------
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=Butterfly
ADMIN_EMAIL=admin@butterfly.local
ADMIN_PASSWORD=changez-ce-mot-de-passe

# ---------------------------------------------------------------------------
# Adresses publiques
# ---------------------------------------------------------------------------
# Port d'accès à l'interface sur la machine hôte.
FRONTEND_PORT=80

# Origine autorisée à appeler l'API, telle que vue par le navigateur.
# À ajuster si FRONTEND_PORT change, par exemple http://localhost:8081
CORS_ALLOWED_ORIGINS=http://localhost

# Racine utilisée pour construire les liens des e-mails. Elle doit correspondre à
# l'adresse que l'utilisateur ouvre dans son navigateur, jamais à un nom de service Docker.
MAIL_FRONT_BASE_URL=http://localhost

# ---------------------------------------------------------------------------
# Personnalisation de l'interface
# ---------------------------------------------------------------------------
# Valeurs figées dans les fichiers du frontend à la construction de l'image :
# les changer impose de reconstruire (docker compose up -d --build frontend).
APP_NAME=Butterfly

# Slogan du pied de page, le caractère | servant de séparateur de ligne.
APP_TAGLINE=

# ---------------------------------------------------------------------------
# Messagerie
# ---------------------------------------------------------------------------
# Par défaut, les messages partent vers le service Mailpit de la stack et sont
# consultables sur http://localhost:8025 sans quitter la machine.
#
# Pour un envoi réel via Brevo, décommentez et renseignez les lignes suivantes.
# Le mot de passe est une clé SMTP (rubrique SMTP & API du compte), jamais le
# mot de passe du compte.
#MAIL_HOST=smtp-relay.brevo.com
#MAIL_PORT=587
#MAIL_USERNAME=votre_identifiant_smtp
#MAIL_PASSWORD=votre_cle_smtp
#MAIL_SMTP_AUTH=true
#MAIL_SMTP_STARTTLS=true

# Mis à false, les messages sont journalisés sans être expédiés.
#MAIL_ENABLED=true

MAIL_FROM=no-reply@butterfly.local
MAIL_FROM_NAME=Butterfly

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ---------------------------------------------------------------------------
# Parcours pédagogique
# ---------------------------------------------------------------------------
# Une tentative de quiz est ouverte dès l'accès au quiz : la quitter sans soumettre
# la compte comme un échec. En dessous de ce délai, elle est effacée au lieu d'être
# comptée, ce qui couvre l'ouverture par erreur. À 0, tout abandon compte.
#LEARNING_QUIZ_ABANDON_GRACE_SECONDS=30

# Limites des fichiers joints aux énoncés d'exercices (10485760 = 10 Mo).
#EXERCISE_ATTACHMENT_MAX_FILE_SIZE_BYTES=10485760
#EXERCISE_ATTACHMENT_MAX_FILES=10

# Nombre maximum d'éléments par page accepté par l'API. Une demande plus grande est
# rabaissée sans erreur : à remonter en même temps que les tailles demandées par
# le frontend sinon les listes se retrouvent tronquées sans message.
#PAGE_MAX_SIZE=100

# ---------------------------------------------------------------------------
# Outils
# ---------------------------------------------------------------------------
SONARQUBE_PORT=9000

# Version de Mailpit. Épinglée sur la release mineure, qui reçoit les correctifs
# sans changer de fonctionnalités. Tags disponibles sur hub.docker.com/r/axllent/mailpit.
#MAILPIT_VERSION=v1.31
