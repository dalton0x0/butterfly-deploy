# Variables d'environnement du déploiement conteneurisé.
#
# Copiez ce fichier en .env à côté de docker-compose.yml
# puis renseignez les valeurs marquées comme obligatoires.
# Ce .env ne doit jamais être versionné.
#
# Ce fichier liste tous les réglages de la stack, ceux du backend compris. Une ligne
# commentée (#NOM=valeur) montre la valeur par défaut sans l'imposer : décommentez-la
# pour la changer. Le backend la reçoit au prochain docker compose up -d.
#
# Quelques réglages du backend sont fixés par docker-compose.yml et ne figurent pas ici,
# car la stack en dépend : le profil Spring, le port d'écoute, les adresses de MySQL et
# de Redis, les dossiers des fichiers téléversés.
#
# scripts/check-backend-env.sh vérifie que ce fichier et docker-compose.yml reprennent
# toutes les variables lues par le backend.

# ---------------------------------------------------------------------------
# Emplacement des dépôts (obligatoire si vos clones portent d'autres noms)
# ---------------------------------------------------------------------------
# Chemins relatifs à ce fichier, vers les deux dépôts contenant chacun son Dockerfile.
BACKEND_PATH=../butterfly
FRONTEND_PATH=../butterfly-front

# ---------------------------------------------------------------------------
# Fuseau horaire
# ---------------------------------------------------------------------------
# Fuseau du conteneur backend à régler sur celui des utilisateurs.
# Laissé vide, le conteneur tourne en UTC et les dates affichées par l'interface
# sont décalées d'autant.
TZ=Europe/Paris

# ---------------------------------------------------------------------------
# Base de données (obligatoire)
# ---------------------------------------------------------------------------
DB_ROOT_PASSWORD=changez-ce-mot-de-passe-root
DB_NAME=butterfly
DB_USERNAME=butterfly
DB_PASSWORD=changez-ce-mot-de-passe

# Pool de connexions du backend.
#HIKARI_MAX_POOL_SIZE=10
#HIKARI_MIN_IDLE=2

# Port de la base sur la machine hôte. Sans effet tant que la publication du port n'est
# pas décommentée dans docker-compose.yml : elle ne sert qu'à inspecter la base depuis un
# client SQL. Modifiez-le si une instance MySQL occupe déjà le port 3306.
DB_EXPOSED_PORT=3306

# ---------------------------------------------------------------------------
# Sécurité (obligatoire)
# ---------------------------------------------------------------------------
# Clé de signature des jetons, 32 caractères minimum.
# Générez-la sur la machine plutôt que de l'inventer :
# openssl rand -base64 48
# Jamais sur un site en ligne : un secret produit par un tiers peut être connu de lui.
JWT_SECRET=

# Durée de vie du jeton d'accès et du jeton de renouvellement, en millisecondes
# (15 minutes et 7 jours).
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Validité des liens envoyés par e-mail. Durées acceptées : 30m, 24h, 7d...
#TOKEN_EMAIL_VERIFICATION_TTL=24h
#TOKEN_PASSWORD_RESET_TTL=30m
# Délai laissé pour confirmer une nouvelle adresse après un changement d'adresse
# avant blocage de la connexion. Une inscription publique n'en a pas : l'adresse doit
# être confirmée avant la première connexion.
#TOKEN_EMAIL_VERIFICATION_GRACE=7d
# Nettoyage nocturne des jetons expirés (cron Spring : seconde minute heure jour mois jour-semaine).
#TOKEN_CLEANUP_CRON=0 0 3 * * *

# Purge des comptes jamais vérifiés et sans aucune donnée. La suppression est
# définitive : elle libère l'adresse pour son vrai propriétaire.
#ACCOUNT_CLEANUP_ENABLED=false
#ACCOUNT_CLEANUP_RETENTION=30d
#ACCOUNT_CLEANUP_BATCH_SIZE=200

# ---------------------------------------------------------------------------
# Compte propriétaire de la plateforme, créé au premier démarrage (obligatoire).
# Seul compte que personne ne peut rétrograder ni supprimer. Chez un client, mettre
# l'adresse de son responsable : il pourra transférer la propriété plus tard.
# ---------------------------------------------------------------------------
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=Butterfly
ADMIN_EMAIL=admin@butterfly.local
ADMIN_PASSWORD=changez-ce-mot-de-passe

# ---------------------------------------------------------------------------
# Adresses publiques
# ---------------------------------------------------------------------------
# Ces trois valeurs décrivent la même adresse, celle que l'utilisateur tape dans son
# navigateur. Elles se modifient ensemble. Avec FRONTEND_PORT=8081 par exemple, les
# deux suivantes valent http://localhost:8081. Rien ne signalera l'oubli au démarrage :
# les e-mails partiront simplement avec des liens qui ne mènent nulle part.

# Port d'accès à l'interface sur la machine hôte.
FRONTEND_PORT=80

# Origine autorisée à appeler l'API, telle que vue par le navigateur.
CORS_ALLOWED_ORIGINS=http://localhost

# Racine utilisée pour construire les liens des e-mails. Elle doit correspondre à
# l'adresse que l'utilisateur ouvre dans son navigateur, jamais à un nom de service Docker.
MAIL_FRONT_BASE_URL=http://localhost

# ---------------------------------------------------------------------------
# Personnalisation de l'interface
# ---------------------------------------------------------------------------
# Valeurs figées dans les fichiers du frontend à la construction de l'image :
# les changer impose de reconstruire (docker compose up -d --build frontend).
APP_NAME=Butterfly

# Slogan du pied de page et de l'en-tête des e-mails, le caractère | servant de
# séparateur de ligne. Vide : slogan par défaut.
APP_TAGLINE=

# ---------------------------------------------------------------------------
# Messagerie
# ---------------------------------------------------------------------------
# Par défaut, les messages partent vers le service Mailpit de la stack et sont
# consultables sur http://localhost:8025 sans quitter la machine.
#
# Pour un envoi réel via Brevo, décommentez et renseignez les lignes suivantes.
# Le mot de passe est une clé SMTP (rubrique SMTP & API du compte), jamais le
# mot de passe du compte.
#MAIL_HOST=smtp-relay.brevo.com
#MAIL_PORT=587
#MAIL_USERNAME=votre_identifiant_smtp
#MAIL_PASSWORD=votre_cle_smtp
#MAIL_SMTP_AUTH=true
#MAIL_SMTP_STARTTLS=true

# Délais du relais SMTP, en millisecondes.
#MAIL_CONNECTION_TIMEOUT=5000
#MAIL_TIMEOUT=5000
#MAIL_WRITE_TIMEOUT=5000

# Mis à false, les messages sont journalisés sans être expédiés.
#MAIL_ENABLED=true

# Routes du front qui reçoivent les jetons des e-mails. À changer seulement avec les
# routes du front.
#MAIL_VERIFICATION_PATH=/verification-email?token=
#MAIL_PASSWORD_RESET_PATH=/nouveau-mot-de-passe?token=
#MAIL_ACCOUNT_ACTIVATION_PATH=/activation-compte?token=
# Cache des gabarits d'e-mails.
#THYMELEAF_CACHE=true

MAIL_FROM=no-reply@butterfly.local
MAIL_FROM_NAME=Butterfly

# Notifications pédagogiques : corrections, soumissions, affectations de blocs et
# récapitulatif quotidien des nouveautés. Elles passent par une file d'envoi vidée par lots.
# L'offre gratuite de Brevo est plafonnée à 300 messages par jour.
#NOTIFICATIONS_ENABLED=true
#NOTIFICATIONS_BATCH_SIZE=20
# Heure du récapitulatif (cron Spring : seconde minute heure jour mois jour-semaine)
#NOTIFICATIONS_DIGEST_CRON=0 0 18 * * *
# Fréquence d'envoi des lots, tentatives avant abandon et conservation des messages envoyés.
#NOTIFICATIONS_DISPATCH_INTERVAL=PT30S
#NOTIFICATIONS_MAX_ATTEMPTS=5
#NOTIFICATIONS_SENT_RETENTION=30d

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ---------------------------------------------------------------------------
# Parcours pédagogique
# ---------------------------------------------------------------------------
# Seuil de réussite d'un quiz, entre 0 et 1.
#LEARNING_QUIZ_PASS_THRESHOLD=0.7
# Note maximale d'un exercice.
#LEARNING_MAX_GRADE=20
# Pourcentage à partir duquel un cours est terminé.
#LEARNING_COURSE_COMPLETED_PERCENT=100
# Durée d'une question de quiz qui n'en définit pas, en secondes.
#LEARNING_DEFAULT_QUESTION_TIME_SECONDS=30
# Marge accordée à chaque réponse au delà de cette durée, latence réseau comprise.
#LEARNING_QUIZ_ANSWER_TOLERANCE_SECONDS=5
# Taille des listes « récents » de l'aperçu et du tableau de bord.
#LEARNING_OVERVIEW_RECENT_LIMIT=5
#DASHBOARD_RECENT_BADGES_LIMIT=5

# ---------------------------------------------------------------------------
# Fichiers téléversés
# ---------------------------------------------------------------------------
# Limites des fichiers joints aux énoncés d'exercices (10485760 = 10 Mo).
#EXERCISE_ATTACHMENT_MAX_FILE_SIZE_BYTES=10485760
#EXERCISE_ATTACHMENT_MAX_FILES=10
# Taille maximale d'un rendu d'exercice, d'une image et d'une vidéo, en octets
# (20 Mo, 5 Mo et 200 Mo).
#STORAGE_MAX_FILE_SIZE_BYTES=20971520
#MEDIA_MAX_IMAGE_SIZE_BYTES=5242880
#MEDIA_MAX_VIDEO_SIZE_BYTES=209715200
# Plafonds d'un envoi : un fichier, puis la requête entière. À garder au-dessus des
# tailles précédentes.
#UPLOAD_MAX_FILE_SIZE=200MB
#UPLOAD_MAX_REQUEST_SIZE=210MB
# Un média envoyé puis jamais utilisé par un contenu est supprimé après ce délai.
#MEDIA_PENDING_UPLOAD_RETENTION=24h
#MEDIA_CLEANUP_CRON=0 30 * * * *

# ---------------------------------------------------------------------------
# Pagination et invitations
# ---------------------------------------------------------------------------

# Nombre maximum d'éléments par page accepté par l'API. Une demande plus grande est
# rabaissée sans erreur : à remonter en même temps que les tailles demandées par
# le frontend sinon les listes se retrouvent tronquées sans message.
#PAGE_MAX_SIZE=100

# Validité du lien d'invitation reçu par un compte créé par l'administrateur.
# Durées acceptées : 30m, 24h, 7d... Passé ce délai, l'administrateur renvoie l'invitation.
#TOKEN_ACCOUNT_ACTIVATION_TTL=72h

# ---------------------------------------------------------------------------
# Limitation de débit
# ---------------------------------------------------------------------------
# Tentatives de connexion, d'inscription ou de réinitialisation acceptées en rafale par
# adresse IP, régénérées en 5 minutes. Des testeurs derrière le même réseau (centre de formation,
# entreprise) partagent une seule adresse : à relever pour une séance de test en groupe.
#RATE_LIMIT_IP_CAPACITY=20
#RATE_LIMIT_IP_REFILL=5m
# E-mails envoyés en rafale vers une même adresse, régénérés en 15 minutes.
#RATE_LIMIT_EMAIL_CAPACITY=3
#RATE_LIMIT_EMAIL_REFILL=15m
# Tentatives de connexion en rafale sur un même compte, quelle que soit l'adresse IP,
# régénérées en 15 minutes. Un tiers qui les épuise bloque aussi le titulaire pendant
# ce délai : le seuil reste large.
#RATE_LIMIT_LOGIN_CAPACITY=10
#RATE_LIMIT_LOGIN_REFILL=15m
# Un compteur inactif au delà de ce délai est retiré de la mémoire.
#RATE_LIMIT_RETENTION=1h
#RATE_LIMIT_CLEANUP_INTERVAL=PT10M
# Mis à false, aucune limite. À réserver à un test de charge.
#RATE_LIMIT_ENABLED=true

# ---------------------------------------------------------------------------
# Cache
# ---------------------------------------------------------------------------
# redis (par défaut) ou simple. Avec simple, le cache reste dans la mémoire du backend
# et le service redis peut être arrêté. Une panne de Redis ne bloque pas l'application :
# le backend lit alors la base à chaque requête.
#CACHE_TYPE=redis
# Délais d'attente de Redis : courts pour qu'un Redis injoignable ne ralentisse pas
# chaque requête.
#REDIS_TIMEOUT=500ms
#REDIS_CONNECT_TIMEOUT=500ms
# Durée de vie des entrées, filet de sécurité : elles sont invalidées à chaque changement.
#CACHE_PRINCIPAL_TTL=5m
#CACHE_SESSION_STATUS_TTL=5m
# Mémoire utilisable par Redis avant de retirer les clés les moins utilisées.
#REDIS_MAXMEMORY=64mb
#REDIS_VERSION=8.2-alpine

# ---------------------------------------------------------------------------
# Documentation de l'API (Swagger)
# ---------------------------------------------------------------------------
# En-tête affiché en haut de Swagger. Les guillemets sont permis ici : Compose les retire.
#OPEN_API_TITLE="Butterfly API"
#OPEN_API_DESCRIPTION="Plateforme d'apprentissage : apprendre, évoluer, se transformer"
#OPEN_API_CONTACT_NAME="Votre nom"
#OPEN_API_CONTACT_EMAIL=contact@exemple.fr
#OPEN_API_CONTACT_URL=https://exemple.fr
#OPEN_API_LICENSE_NAME="Tous droits réservés"
#OPEN_API_LICENSE_URL=https://exemple.fr
# Version affichée dans Swagger. Laissée commentée, elle suit celle du pom.xml. Une
# valeur vide l'effacerait.
#OPEN_API_VERSION=3.8.0

# ---------------------------------------------------------------------------
# Journaux du backend
# ---------------------------------------------------------------------------
# Rotation du fichier de journal. Sans effet avec le profil docker, qui écrit seulement
# sur la sortie standard. Utile en pré-production si un fichier de journal est activé.
#LOG_MAX_FILE_SIZE=10MB
#LOG_MAX_HISTORY=14
#LOG_TOTAL_SIZE_CAP=500MB

# ---------------------------------------------------------------------------
# Pré-production (docker-compose.preprod.yml), voir PREPROD.md
# ---------------------------------------------------------------------------
# Domaine public, dont l'enregistrement DNS pointe vers le VPS.
#DOMAIN=butterfly.cheridanh.fr
# Adresse prévenue par Let's Encrypt si le renouvellement du certificat échoue.
#ACME_EMAIL=vous@exemple.fr
#CADDY_VERSION=2.10-alpine
# Plafond mémoire du conteneur Caddy.
#CADDY_MEM_LIMIT=128m

# ---------------------------------------------------------------------------
# Outils
# ---------------------------------------------------------------------------
SONARQUBE_PORT=9000

# Version de SonarQube. Épinglée pour qu'une montée de version majeure qui change les
# règles d'analyse reste une décision et non une surprise au premier redémarrage.
# Tag complet obligatoire, sans tag court par année. Pour lister les plus récents :
# curl -s "https://hub.docker.com/v2/repositories/library/sonarqube/tags?page_size=30&ordering=last_updated" | grep -o '"name":"[^"]*-community"'
#SONARQUBE_VERSION=25.11.0.114957-community

# ---------------------------------------------------------------------------
# Plafonds mémoire
# ---------------------------------------------------------------------------
# Bornent chaque conteneur pour qu'un service qui dérive ne fasse pas tuer ses voisins
# par le noyau. À relever si un service se termine avec le code 137 (mémoire épuisée).
#MYSQL_MEM_LIMIT=768m
#BACKEND_MEM_LIMIT=1g
#REDIS_MEM_LIMIT=128m
#SONARQUBE_MEM_LIMIT=3g

# Version de Mailpit. Épinglée sur la release mineure, qui reçoit les correctifs
# sans changer de fonctionnalités. Tags disponibles sur hub.docker.com/r/axllent/mailpit.
#MAILPIT_VERSION=v1.31
